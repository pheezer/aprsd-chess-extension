[Unit]
Description=APRS Chess web board (aprsd-chess-extension)
# Stop chess when DigiPi switches to a mode that takes over the radio.
# Conflicts= works in both directions, so those units need no changes.
Conflicts=node.service winlinkrms.service ardop.service mercury.service fldigi.service js8call.service sstv.service wsjtx.service

[Service]
ExecStartPre=sleep 1
ExecStart=/home/pi/chess.sh
WorkingDirectory=/home/pi/
StandardOutput=inherit
StandardError=inherit
Restart=no
User=pi
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
